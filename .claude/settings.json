{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo nextest:*)",
      "Bash(cargo run:*)",
      "Bash(cargo insta:*)",
      "Bash(cargo tree:*)",
      "Bash(just:*)",
      "Bash(nix develop -c just:*)",
      "Bash(nix develop --command just:*)",
      "Bash(nix develop -c cargo:*)",
      "Bash(nix develop --command cargo:*)",
      "Bash(nix develop -c git add:*)",
      "Bash(nix develop --command git add:*)",
      "Bash(nix develop -c git commit:*)",
      "Bash(nix develop --command git commit:*)",
      "Bash(nix develop -c scripts/:*)",
      "Bash(nix develop --command scripts/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(scripts/tmux-harness.sh:*)",
      "Bash(scripts/test-hooks.sh:*)",
      "Bash(scripts/test-harness.sh:*)"
    ],
    "ask": [
      "Bash(just install:*)",
      "Bash(just dev:*)",
      "Bash(nix develop -c just install:*)",
      "Bash(nix develop -c just dev:*)",
      "Bash(nix develop --command just install:*)",
      "Bash(nix develop --command just dev:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt-edited.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/clippy-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
